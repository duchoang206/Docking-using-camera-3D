<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>camera3d_docking_sim</name>
  <version>0.1.0</version>
  <description>Mô phỏng Gazebo Harmonic cho camera3d_docking: robot vi sai + camera RGB-D + pallet/rack sinh từ cùng mô hình hộp với template, kèm kịch bản test end-to-end.</description>
  <maintainer email="todo@example.com">Docking3D Dev</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>camera3d_docking</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

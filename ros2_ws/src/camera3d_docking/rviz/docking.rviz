Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.4
    - Class: rviz_default_plugins/PointCloud2
      Name: Camera cloud
      Enabled: true
      Topic:
        Value: /camera/points
        Reliability Policy: Best Effort
        Depth: 1
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
    - Class: rviz_default_plugins/PointCloud2
      Name: Aligned template
      Enabled: true
      Topic:
        Value: /pose_estimator/aligned_template
        Depth: 1
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 0; 255; 0
    - Class: rviz_default_plugins/Pose
      Name: Detected dock pose
      Enabled: true
      Topic:
        Value: /detected_dock_pose
      Shape: Axes
      Axes Length: 0.4
      Axes Radius: 0.03
  Global Options:
    Fixed Frame: odom
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5.0
      Focal Point:
        X: 2.0
        Y: 0.0
        Z: 0.0
      Pitch: 0.7
      Yaw: 3.5
Window Geometry:
  Width: 1400
  Height: 900
